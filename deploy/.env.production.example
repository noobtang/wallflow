# ===== WallFlow 生产环境模板 =====
# 复制为 deploy/.env 并填写(该文件已被 .gitignore 忽略,不会入库)
# 生成随机密钥: openssl rand -hex 32

# ---- 域名(DNS 解析到本服务器) ----
DOMAIN=api.wallflow.example.com

# ---- 数据库(容器内自建,仅内网访问) ----
POSTGRES_USER=wallflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wallflow

# ---- 运行 ----
NODE_ENV=production
PORT=3000
# 生产必填!config.ts 会拒绝默认 dev 密钥
JWT_SECRET=openssl-rand-hex-32

# ---- 微信小程序(合法域名需 ICP 备案) ----
WECHAT_APPID=
WECHAT_SECRET=
# 生产未配置时,内容安全自动降级: 导入的图全部 pending_review(不入用户流),见 content-safety.ts

# ---- 对象存储(图片签名直链;当前 COS 方案,后期可换其他供应商,接口不变) ----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wallflow-wallpapers-1250000000
COS_REGION=ap-guangzhou
# 注意: 配置后需把图片域名(COS bucket 自定义域名/默认域名)加入小程序 downloadFile 合法域名
