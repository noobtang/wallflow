# ===== WallFlow 生产环境模板 =====
# 复制为 deploy/.env 并填写(该文件已被 .gitignore 忽略,不会入库)
# 生成随机密钥: openssl rand -hex 32

# ---- 域名(DNS 解析到本服务器) ----
DOMAIN=api.wallflow.example.com

# ---- 数据库(容器内自建,仅内网访问) ----
POSTGRES_USER=wallflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wallflow

# ---- 运行 ----
NODE_ENV=production
PORT=3000
# 生产必填!config.ts 会拒绝默认 dev 密钥
JWT_SECRET=openssl-rand-hex-32

# ---- 微信小程序(合法域名需 ICP 备案) ----
WECHAT_APPID=
WECHAT_SECRET=
# 生产未配置时,内容安全自动降级: 导入的图全部 pending_review(不入用户流),见 content-safety.ts

# ---- 图片存储(2026-08-15 起: 自有服务器 + 域名优先,COS 为第二选项;都配置时优先自有存储) ----
# 首选 — 自有服务器存储: 图片字节落盘到 SELF_HOST_STORAGE_DIR(容器内路径,见 compose 的 images 卷),
# nginx 以 /images/* 静态服务(免签名,公开读 + 缓存头);SELF_HOST_BASE_URL 为该目录的公网域名
# 例: SELF_HOST_STORAGE_DIR=/data/wallflow/images  SELF_HOST_BASE_URL=https://images.wallflow.example.com
SELF_HOST_STORAGE_DIR=
SELF_HOST_BASE_URL=
# 第二选项 — 腾讯云 COS(私有读 + 签名直链)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wallflow-wallpapers-1250000000
COS_REGION=ap-guangzhou
# 注意: 配置后需把图片域名(自有图片域名或 COS 域名)加入小程序 downloadFile 合法域名

# ---- 管理员接口(#12 运维补全) ----
# 空 = 管理路由 503 不暴露;上线前必须设置强随机值(openssl rand -hex 32)
ADMIN_API_KEY=

# ---- 运维告警(#12 告警接入) ----
# 5xx → 群机器人 webhook(企业微信/钉钉群机器人通用);空 = 禁用
# 窗口内多条 5xx 合并为一条通知,默认 60s
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_MIN_INTERVAL_SECONDS=60

# ---- 公开写接口限流(2026-08-15) ----
# 滑动窗口(ms)内单 IP 最大请求数;保护 /events /reports /favorites /unlock 防脚本刷
# 默认 60s 内 300 次,对小程序正常用量绰绰有余
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
