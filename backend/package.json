{
  "name": "wallflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WallFlow backend API — free-license wallpaper service",
  "engines": {
    "node": ">=20.19"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:dry-run": "tsx src/cli/dry-run.ts",
    "backfill:search": "tsx src/cli/backfill-search.ts",
    "backfill:cos-keys": "tsx src/cli/backfill-cos-keys.ts",
    "cos:configure": "tsx src/cli/cos-configure.ts",
    "import": "tsx src/cli/import.ts",
    "db:up": "node-pg-migrate up",
    "db:down": "node-pg-migrate down",
    "db:reset": "node-pg-migrate down --all && node-pg-migrate up",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.21.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.10"
  }
}
