# 运行环境
NODE_ENV=development
PORT=3000

# 数据库(#2 起使用;骨架阶段启动即校验,缺失会报错)
DATABASE_URL=postgres://user:password@localhost:5432/wallflow

# 微信小程序(#7 起使用)
WECHAT_APPID=
WECHAT_SECRET=

# 会话密钥(#7 起使用,生产必须替换)
JWT_SECRET=change-me-in-production

# 腾讯云 COS(#4/#8 起使用)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wallflow-wallpapers
COS_REGION=ap-guangzhou
