# 运行环境
NODE_ENV=development
PORT=3000

# 数据库(#2 起使用;骨架阶段启动即校验,缺失会报错)
DATABASE_URL=postgres://user:password@localhost:5432/wallflow

# 微信小程序(#7 起使用)
WECHAT_APPID=
WECHAT_SECRET=

# 会话密钥(#7 起使用,生产必须替换)
JWT_SECRET=change-me-in-production

# 图片存储(2026-08-15 起: 自有服务器存储为首选,COS 为第二选项;两者都配置时优先自有存储)
# 首选 — 自有服务器 + 域名: 图片字节落盘到 SELF_HOST_STORAGE_DIR(生产部署时与 nginx 共享卷),
# nginx 以 /images/* 静态服务(见 deploy/docker-compose.prod.yml);SELF_HOST_BASE_URL 为公网访问域名
# 例: SELF_HOST_STORAGE_DIR=/data/wallflow/images  SELF_HOST_BASE_URL=https://images.example.com
SELF_HOST_STORAGE_DIR=
SELF_HOST_BASE_URL=
# 第二选项 — 腾讯云 COS(#4/#8 起使用)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wallflow-wallpapers
COS_REGION=ap-guangzhou

# 管理员接口(#12 运维补全): 空 → 管理路由 503 不暴露;上线前必须设置强随机值
# 生成: openssl rand -hex 32
ADMIN_API_KEY=

# 运维告警(#12 告警接入): 群机器人 webhook URL(企业微信/钉钉群机器人通用),空 → 禁用
# 窗口内多条 5xx 合并为一条通知,默认 60s
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_MIN_INTERVAL_SECONDS=60

# 公开写接口限流(2026-08-15 E 运维小项): 滑动窗口(ms)内单 IP 最大请求数
# 保护 /events /reports /favorites /unlock 防脚本刷;生产在 nginx 后按 X-Forwarded-For 计数
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
