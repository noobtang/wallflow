/**
 * 全局样式: 颜色全部走 CSS 变量。
 * - 默认(明亮清新)值定义在 page 上;深色由 theme.json(darkmode 跟随系统)注入覆盖
 * - 手动主题切换: 页面根容器挂 .theme--light / .theme--dark 类强制覆盖(内容区生效,
 *   原生导航栏/胶囊仍跟随系统 — 已知限制,见 DESIGN-UI.md §6)
 */
page {
  --bg: #f5f5f3;
  --card: #ffffff;
  --text1: #1a1a1a;
  --text2: rgba(26, 26, 26, 0.65);
  --border: rgba(26, 26, 26, 0.08);
  --primary: #4a6cff;
  --cc0: #0fa47c;
  --ccby: #2b6fdd;
  --pd: #6b7280;
  --danger: #e5484d;
  --grad1: #4a6cff;
  --grad2: #7a5cff;
  --skeleton: rgba(26, 26, 26, 0.06);
  --overlay: rgba(0, 0, 0, 0.45);
  --bar: rgba(255, 255, 255, 0.92);

  background: var(--bg);
  color: var(--text1);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.theme--light {
  --bg: #f5f5f3;
  --card: #ffffff;
  --text1: #1a1a1a;
  --text2: rgba(26, 26, 26, 0.65);
  --border: rgba(26, 26, 26, 0.08);
  --primary: #4a6cff;
  --cc0: #0fa47c;
  --ccby: #2b6fdd;
  --pd: #6b7280;
  --danger: #e5484d;
  --grad1: #4a6cff;
  --grad2: #7a5cff;
  --skeleton: rgba(26, 26, 26, 0.06);
  --overlay: rgba(0, 0, 0, 0.45);
  --bar: rgba(255, 255, 255, 0.92);
}

.theme--dark {
  --bg: #0b0c0f;
  --card: #16171c;
  --text1: #ffffff;
  --text2: rgba(255, 255, 255, 0.7);
  --border: rgba(255, 255, 255, 0.1);
  --primary: #6e8cff;
  --cc0: #2ecc9f;
  --ccby: #4a90ff;
  --pd: #9aa0a6;
  --danger: #ff5c5c;
  --grad1: #6e8cff;
  --grad2: #8a6cff;
  --skeleton: rgba(255, 255, 255, 0.08);
  --overlay: rgba(0, 0, 0, 0.55);
  --bar: rgba(11, 12, 15, 0.92);
}

/* 页面根容器: 铺满背景,保证手动主题覆盖整页 */
.root {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* 通用状态区(加载/空/错误) */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text2);
  font-size: 26rpx;
  gap: 16rpx;
}

.state__emoji {
  font-size: 72rpx;
}

.state__btn {
  margin-top: 16rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--grad1), var(--grad2));
  color: #fff;
  font-size: 26rpx;
  border: none;
}

.state__btn::after {
  border: none;
}

/* 加载 spinner */
.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  display: inline-block;
  vertical-align: middle;
  margin-right: 12rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
