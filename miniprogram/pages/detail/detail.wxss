.root {
  position: relative;
  padding-bottom: 180rpx;
}

/* 返回按钮 */
.nav-back {
  position: fixed;
  top: 12rpx;
  left: 24rpx;
  z-index: 20;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bar);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.nav-back__arrow {
  font-size: 44rpx;
  color: var(--text1);
  line-height: 1;
  margin-top: -4rpx;
}

/* 沉浸大图区(约 65vh) */
.hero {
  height: 62vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
}

.hero__img {
  width: 100%;
  height: 100%;
}

.hero__img--error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--text2);
  font-size: 26rpx;
  background: var(--bg);
}

.hero__retry {
  color: var(--primary);
  text-decoration: underline;
}

/* 信息区 */
.body {
  padding: 28rpx 32rpx 0;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text1);
}

.badge {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.badge--cc0 {
  background: var(--cc0);
}

.badge--ccby {
  background: var(--ccby);
}

.badge--pd {
  background: var(--pd);
}

.badge--default {
  background: rgba(0, 0, 0, 0.55);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text2);
  background: var(--card);
  border: 1rpx solid var(--border);
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.meta__creator {
  font-size: 24rpx;
  color: var(--text1);
}

.meta__license {
  font-size: 24rpx;
  color: var(--primary);
}

/* 完整署名(#12): 点击查看 + 复制 */
.attr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.attr__text {
  font-size: 24rpx;
  color: var(--text2);
}

.attr__arrow {
  font-size: 28rpx;
  color: var(--text3);
}

/* 相似推荐 */
.similar {
  margin-top: 28rpx;
}

.similar__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text1);
}

.similar__scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.similar__item {
  position: relative;
  display: inline-block;
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
  background: var(--skeleton);
}

.similar__img {
  width: 100%;
  height: 100%;
}

.similar__badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 18rpx;
}

/* 底部固定操作栏(毛玻璃) */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bar);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--border);
}

.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-width: 88rpx;
  padding: 8rpx 0;
}

.action__icon {
  font-size: 40rpx;
  color: var(--text1);
  line-height: 1;
}

.action__icon--active {
  color: var(--danger);
}

.action__label {
  font-size: 20rpx;
  color: var(--text2);
}

.cta {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--grad1), var(--grad2));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(74, 108, 255, 0.28);
}

.cta::after {
  border: none;
}

.cta[disabled] {
  opacity: 0.7;
}
