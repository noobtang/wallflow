.root {
  padding: 20rpx 24rpx 40rpx;
}

/* 搜索条 */
.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}

.search-bar__icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-bar__placeholder {
  font-size: 26rpx;
  color: var(--text2);
}

/* 今日精选(静态运营位) */
.featured {
  position: relative;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.featured__img {
  width: 100%;
  height: 100%;
}

.featured__mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, var(--overlay) 100%);
}

.featured__info {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.featured__label {
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--grad1), var(--grad2));
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.featured__title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.featured__license {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: 20rpx;
}

.waterfall__col {
  flex: 1;
  min-width: 0;
}

/* 骨架屏 */
.skeleton {
  display: flex;
  gap: 20rpx;
}

.skeleton__col {
  flex: 1;
  min-width: 0;
}

.skeleton__block {
  border-radius: 16rpx;
  background: var(--skeleton);
  margin-bottom: 20rpx;
}
