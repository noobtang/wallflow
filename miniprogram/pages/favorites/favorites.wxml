<view class="root {{themeClass}}">
  <!-- 头部: 标题 + 主题切换 + 关于 -->
  <view class="header">
    <text class="header__title">我的收藏</text>
    <view class="header__actions">
      <text class="header__link" bindtap="onThemeTap">主题</text>
      <text class="header__link" bindtap="onAboutTap">关于</text>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{skeleton}}" class="skeleton">
    <view class="skeleton__col">
      <view class="skeleton__block" style="height: 340rpx"></view>
      <view class="skeleton__block" style="height: 460rpx"></view>
    </view>
    <view class="skeleton__col">
      <view class="skeleton__block" style="height: 440rpx"></view>
      <view class="skeleton__block" style="height: 320rpx"></view>
    </view>
  </view>

  <!-- 收藏夹瀑布流(长按可取消收藏) -->
  <view wx:elif="{{!error && !empty}}" class="waterfall">
    <view class="waterfall__col">
      <wallpaper-card
        wx:for="{{left}}"
        wx:key="id"
        item="{{item}}"
        bind:tap="onCardTap"
        bind:longpress="onCardLongPress"
      />
    </view>
    <view class="waterfall__col">
      <wallpaper-card
        wx:for="{{right}}"
        wx:key="id"
        item="{{item}}"
        bind:tap="onCardTap"
        bind:longpress="onCardLongPress"
      />
    </view>
  </view>

  <view wx:if="{{loading && !skeleton && !error}}" class="state state--loading">
    <text class="spinner"></text><text>加载中…</text>
  </view>

  <view wx:if="{{finished && !error && !empty}}" class="state">— 已经到底啦 —</view>

  <!-- 空态: 未收藏 -->
  <view wx:if="{{empty}}" class="state state--empty">
    <text class="state__emoji">💙</text>
    <text>还没有收藏壁纸</text>
    <text class="empty__hint">去发现页逛逛,遇到喜欢的点个收藏</text>
  </view>

  <!-- 错误 -->
  <view wx:if="{{error}}" class="state state--error">
    <text class="state__emoji">📡</text>
    <text>加载失败,请确认已登录</text>
    <button class="state__btn" bindtap="onRetry">点击重试</button>
  </view>
</view>
